# Copy to .env, then run: docker compose up --build
POSTGRES_DB=simponi
POSTGRES_USER=simponi
POSTGRES_PASSWORD=ganti-password-ini

# First admin account, created only when the database has no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
ADMIN_FULL_NAME=Administrator

# Public origin(s) of the web app, comma separated. Must match the address you open in the browser.
ALLOWED_ORIGINS=http://localhost:3000
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

SESSION_IDLE_MINUTES=60
REMEMBER_ME_DAYS=7
GRID_CELL_SIZE_M=100
MAX_UPLOAD_MB=10240
# Swagger UI at /api/docs. Set to false in production.
ENABLE_DOCS=true

# Optional OpenStreetMap tile server. Default: tile.openstreetmap.org (fine for development, see its usage policy).
NEXT_PUBLIC_TILES_STREETS=
